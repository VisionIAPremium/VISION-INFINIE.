# Copy to .env. Never commit this file or share its values.
VISION_INFINIE_PROVIDER=local
VISION_INFINIE_TOKEN_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
VISION_INFINIE_HOST=0.0.0.0
VISION_INFINIE_PORT=8765

# Optional remote model provider. Keep disabled until explicitly configured.
# VISION_INFINIE_PROVIDER=openai-compatible
# VISION_INFINIE_BASE_URL=https://api.provider.example/v1
# VISION_INFINIE_MODEL=your-model
# VISION_INFINIE_API_KEY=your-secret-api-key

# Airtable is not activated by this deployment template.
# AIRTABLE_BASE_ID=
# AIRTABLE_TOKEN=
